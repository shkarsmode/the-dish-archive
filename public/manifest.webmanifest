{
    "name": "The Dish Archive",
    "short_name": "Рецепти",
    "description": "Сімейна кулінарна книга: рецепти з Instagram, TikTok, YouTube, фото чи вручну.",
    "lang": "uk",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#FAFAF7",
    "theme_color": "#B8926A",
    "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
        { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "share_target": {
        "action": "/recipes/new",
        "method": "GET",
        "params": { "title": "title", "text": "text", "url": "url" }
    },
    "shortcuts": [
        { "name": "Додати рецепт", "url": "/recipes/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
